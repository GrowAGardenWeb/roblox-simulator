{
  "name": "robloxpcapp",
  "version": "0.1.0",
  "description": "Roblox for PC (recreation)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "shop.moneyscripts.robloxpcapp",
    "productName": "Roblox",
    "files": ["index.html", "style.css", "app.js", "img/**", "main.js", "preload.js", "icon.png"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}
